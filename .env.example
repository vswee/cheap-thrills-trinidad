# Telegram issue-report delivery (server-side only; never use NEXT_PUBLIC_)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discovery keys (GitHub Actions secrets for scheduled runs; optional locally)
TAVILY_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional public channel URL override; defaults to https://t.me/CheapThrillsTrinidad
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=
# Public channel delivery: GitHub Actions secret, separate from private report chat
TELEGRAM_CHANNEL_ID=
